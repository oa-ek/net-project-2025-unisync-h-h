@page
@model LoginModel

@{
    ViewData["Title"] = "Вхід в систему";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="text-center mb-4">@ViewData["Title"]</h1>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Електронна пошта</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            Запам'ятати мене
                        </label>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Увійти</button>
                    </div>

                    @if (Model.ExternalLogins?.Count > 0)
                    {
                        <div class="mt-4">
                            <div class="d-flex align-items-center mb-3">
                                <hr class="flex-grow-1" />
                                <span class="mx-2 text-muted">або</span>
                                <hr class="flex-grow-1" />
                            </div>

                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                @foreach (var provider in Model.ExternalLogins)
                                {
                                    @if (provider.Name == "Google")
                                    {
                                        <button type="submit" class="w-100 btn btn-lg btn-outline-dark mb-3" name="provider" value="@provider.Name">
                                            <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" style="height: 24px; margin-right: 8px;" />
                                            Увійти через Google
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="w-100 btn btn-lg btn-outline-dark mb-3" name="provider" value="@provider.Name">
                                            Увійти через @provider.DisplayName
                                        </button>
                                    }
                                }
                            </form>
                        </div>
                    }

                    <div class="mt-3 text-center">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword">Забули пароль?</a>
                        </p>
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Зареєструватися як новий користувач</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}