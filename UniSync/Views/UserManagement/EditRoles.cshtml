@model UniSync.Models.ViewModels.EditUserRolesViewModel
@using UniSync.Constants

@{
    ViewData["Title"] = "Редагування ролей";
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h1 class="fw-bold mb-4">Редагування ролей користувача</h1>
        <h4 class="mb-3">@Model.UserName (@Model.Email)</h4>

        <form asp-action="EditRoles" method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />
            <input type="hidden" asp-for="Email" />

            <div class="list-group mb-4">
                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    <div class="list-group-item">
                        <div class="form-check">
                            <input type="hidden" asp-for="@Model.Roles[i].Name" />
                            @if (Model.Roles[i].Name == Roles.SuperAdmin && Model.Roles[i].IsSelected)
                            {
                                <input class="form-check-input" type="checkbox" asp-for="@Model.Roles[i].IsSelected" id="role-@i" disabled checked />
                                <input type="hidden" asp-for="@Model.Roles[i].IsSelected" value="true" />
                                <label class="form-check-label" for="role-@i">
                                    @Model.Roles[i].Name <span class="text-muted">(не можна видалити)</span>
                                </label>
                            }
                            else if (Model.Roles[i].Name == Roles.SuperAdmin)
                            {
                                <input class="form-check-input superadmin-checkbox" type="checkbox" id="role-@i"
                                       data-role-index="@i" @(Model.Roles[i].IsSelected ? "checked" : "") />
                                <input type="hidden" asp-for="@Model.Roles[i].IsSelected" id="hidden-role-@i" />
                                <label class="form-check-label" for="role-@i">
                                    @Model.Roles[i].Name <span class="text-danger">(потребує підтвердження)</span>
                                </label>
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" asp-for="@Model.Roles[i].IsSelected" id="role-@i" />
                                <label class="form-check-label" for="role-@i">
                                    @Model.Roles[i].Name
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>Зберегти зміни
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Назад до списку
                </a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="superAdminConfirmModal" tabindex="-1" aria-labelledby="superAdminConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="superAdminConfirmModalLabel">Підтвердження ролі SuperAdmin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-danger">Увага! Ви намагаєтесь надати користувачу роль SuperAdmin.</p>
                <p>Ця роль має повний доступ до всіх функцій системи. Для підтвердження введіть пароль адміністратора:</p>
                <div class="mb-3">
                    <label for="adminPassword" class="form-label">Пароль адміністратора</label>
                    <input type="password" class="form-control" id="adminPassword">
                    <div id="passwordError" class="text-danger mt-2" style="display: none;">
                        Невірний пароль. Спробуйте ще раз.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                <button type="button" class="btn btn-danger" id="confirmSuperAdminBtn">Підтвердити</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentRoleIndex = -1;
            let superAdminModal = new bootstrap.Modal(document.getElementById('superAdminConfirmModal'));

            document.querySelectorAll('.superadmin-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function(e) {
                    currentRoleIndex = this.getAttribute('data-role-index');

                    if (this.checked) {
                        e.preventDefault(); 
                        this.checked = false;
                        superAdminModal.show();
                    } else {
                        document.getElementById(`hidden-role-${currentRoleIndex}`).value = "false";
                    }
                });
            });

            document.getElementById('confirmSuperAdminBtn').addEventListener('click', function() {
                const password = document.getElementById('adminPassword').value;

                fetch('@Url.Action("VerifySuperAdminPassword", "UserManagement")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ password: password })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.querySelector(`.superadmin-checkbox[data-role-index="${currentRoleIndex}"]`).checked = true;
                        document.getElementById(`hidden-role-${currentRoleIndex}`).value = "true";
                        superAdminModal.hide();
                        document.getElementById('passwordError').style.display = 'none';
                        document.getElementById('adminPassword').value = '';
                    } else {
                        document.getElementById('passwordError').style.display = 'block';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('passwordError').style.display = 'block';
                });
            });

            document.getElementById('superAdminConfirmModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('adminPassword').value = '';
                document.getElementById('passwordError').style.display = 'none';
            });
        });
    </script>
}