@model UniSync.Models.ViewModels.LockedAccountViewModel

@{
    ViewData["Title"] = "Обліковий запис заблоковано";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-lock-fill me-2"></i>
                        Обліковий запис заблоковано
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="avatar-initials avatar-initials-lg mb-3 mx-auto bg-danger text-white">
                            @{
                                var nameParts = Model.UserName?.Split(' ');
                                var firstInitial = nameParts != null && nameParts.Length > 0 && !string.IsNullOrEmpty(nameParts[0]) ? nameParts[0][0] : '?';
                                var secondInitial = nameParts != null && nameParts.Length > 1 && !string.IsNullOrEmpty(nameParts[1]) ? nameParts[1][0] : ' ';
                            }
                            @firstInitial@secondInitial
                        </div>
                        <h5 class="fw-bold">@Model.UserName</h5>
                        <p class="text-muted">@Model.Email</p>
                    </div>

                    <div class="alert alert-danger mb-4">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Ваш обліковий запис заблоковано
                        </h5>
                        <hr>
                        <p>На жаль, ваш обліковий запис було заблоковано адміністрацією сайту.</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold">Причина блокування:</h6>
                        <p>@Model.LockoutReason</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold">Термін блокування:</h6>
                        <p>
                            @if (Model.IsPermanent)
                            {
                                <span class="text-danger">Постійне блокування</span>
                            }
                            else
                            {
                                <span>До @Model.FormattedLockoutEnd (залишилось: @Model.TimeRemaining)</span>
                            }
                        </p>
                    </div>

                    <div class="alert alert-info">
                        <h6 class="alert-heading">
                            <i class="bi bi-info-circle me-2"></i>
                            Що робити далі?
                        </h6>
                        <p class="mb-0">
                            Якщо ви вважаєте, що блокування було помилковим, або у вас є питання щодо вашого облікового запису,
                            будь ласка, зв'яжіться з адміністрацією сайту за адресою
                            <a href="mailto:support@unisync.com">support@unisync.com</a>.
                        </p>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="text-center mt-4">
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Вийти з системи
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mt-4">
                            <a href="@Url.Page("/Account/Login", new { area = "Identity" })" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>
                                Повернутися до входу
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-initials-lg {
        width: 80px;
        height: 80px;
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
</style>