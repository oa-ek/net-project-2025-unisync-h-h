@model IEnumerable<UniSync.Models.Entity.News>

@{
    ViewData["Title"] = "Управління новинами";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-newspaper me-2"></i>Управління новинами</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Створити новину
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control" placeholder="Пошук новин...">
                        <button class="btn btn-outline-secondary" type="button" id="searchButton">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6">
                    <select id="categoryFilter" class="form-select float-md-end w-auto">
                        <option value="">Усі категорії</option>
                        @foreach (var category in Enum.GetValues(typeof(UniSync.Models.Entity.NewsCategory)))
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle me-2"></i>Наразі немає доступних новин.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="newsTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Заголовок</th>
                                <th>Категорія</th>
                                <th>Дата публікації</th>
                                <th>Автор</th>
                                <th>Важлива</th>
                                <th>Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Title" class="me-2" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px; border-radius: 4px;">
                                                    <i class="bi bi-newspaper text-secondary"></i>
                                                </div>
                                            }
                                            <div class="text-truncate" style="max-width: 250px;" title="@item.Title">@item.Title</div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary">@item.Category</span></td>
                                    <td>@item.PublishedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.AuthorName</td>
                                    <td>
                                        @if (item.IsImportant)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>Так</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ні</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Переглянути">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редагувати">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Видалити">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <span>Всього новин: @Model.Count()</span>
                <div>
                    <span class="me-3">
                        <i class="bi bi-exclamation-circle text-danger me-1"></i>Важливих: @Model.Count(n => n.IsImportant)
                    </span>
                    <span>
                        <i class="bi bi-calendar-event me-1"></i>За останній місяць: @Model.Count(n => n.PublishedDate >= DateTime.Now.AddMonths(-1))
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Пошук новин
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#newsTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Фільтр за категорією
            $("#categoryFilter").on("change", function () {
                var value = $(this).val().toLowerCase();
                if (value === "") {
                    $("#newsTable tbody tr").show();
                } else {
                    $("#newsTable tbody tr").filter(function () {
                        var categoryText = $(this).find("td:eq(2)").text().toLowerCase();
                        $(this).toggle(categoryText.indexOf(value) > -1);
                    });
                }
            });
        });
    </script>
}