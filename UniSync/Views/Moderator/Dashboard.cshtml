@using UniSync.Models.Entity
@model IEnumerable<UniSync.Models.Entity.ContentReport>

@{
    ViewData["Title"] = "Панель модератора";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Панель модератора</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Очікуючі звіти</h6>
                            <h2 class="mt-2 mb-0">@ViewBag.PendingReportsCount</h2>
                        </div>
                        <i class="bi bi-exclamation-circle fs-1"></i>
                    </div>
                </div>
                <div class="card-footer bg-primary border-top border-white border-opacity-25">
                    <a asp-action="Index" class="text-white text-decoration-none">
                        <small>Переглянути всі <i class="bi bi-arrow-right ms-1"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Оброблено сьогодні</h6>
                            <h2 class="mt-2 mb-0">
                                @(await ViewContext.HttpContext.RequestServices
                                    .GetRequiredService<UniSync.Repositories.IContentReportRepository>()
                                    .GetAllReportsAsync()).Count(r => r.ResolvedAt?.Date == DateTime.Today)
                            </h2>
                        </div>
                        <i class="bi bi-check2-circle fs-1"></i>
                    </div>
                </div>
                <div class="card-footer bg-success border-top border-white border-opacity-25">
                    <a asp-action="AllReports" class="text-white text-decoration-none">
                        <small>Переглянути всі <i class="bi bi-arrow-right ms-1"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Всього звітів</h6>
                            <h2 class="mt-2 mb-0">
                                @(await ViewContext.HttpContext.RequestServices
                                    .GetRequiredService<UniSync.Repositories.IContentReportRepository>()
                                    .GetAllReportsAsync()).Count()
                            </h2>
                        </div>
                        <i class="bi bi-flag fs-1"></i>
                    </div>
                </div>
                <div class="card-footer bg-info border-top border-white border-opacity-25">
                    <a asp-action="AllReports" class="text-white text-decoration-none">
                        <small>Переглянути статистику <i class="bi bi-arrow-right ms-1"></i></small>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Останні звіти</h5>
                        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Переглянути всі</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info m-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>Немає нових звітів.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Тип</th>
                                        <th>Причина</th>
                                        <th>Дата</th>
                                        <th>Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Take(5))
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>
                                                @switch (item.ContentType)
                                                {
                                                    case ContentType.News:
                                                        <span class="badge bg-primary">Новина</span>
                                                        break;
                                                    case ContentType.Comment:
                                                        <span class="badge bg-info">Коментар</span>
                                                        break;
                                                    case ContentType.UserProfile:
                                                        <span class="badge bg-warning">Профіль</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">Інше</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @switch (item.Reason)
                                                {
                                                    case ReportReason.Spam:
                                                        <span class="badge bg-warning">Спам</span>
                                                        break;
                                                    case ReportReason.Offensive:
                                                        <span class="badge bg-danger">Образливий вміст</span>
                                                        break;
                                                    case ReportReason.Misinformation:
                                                        <span class="badge bg-info">Недостовірна інформація</span>
                                                        break;
                                                    case ReportReason.RuleViolation:
                                                        <span class="badge bg-dark">Порушення правил</span>
                                                        break;
                                                    case ReportReason.Other:
                                                        <span class="badge bg-secondary">Інше</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <div class="btn-group">
                                                    <a asp-action="ReportDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Деталі">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-action="ProcessReport" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Обробити">
                                                        <i class="bi bi-check2"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Статистика звітів</h5>
                </div>
                <div class="card-body">
                    <h6>За типом контенту</h6>
                    <div class="mb-4">
                        @{
                            var allReports = await ViewContext.HttpContext.RequestServices
                            .GetRequiredService<UniSync.Repositories.IContentReportRepository>()
                            .GetAllReportsAsync();

                            var newsCounts = allReports.Count(r => r.ContentType == ContentType.News);
                            var commentCounts = allReports.Count(r => r.ContentType == ContentType.Comment);
                            var profileCounts = allReports.Count(r => r.ContentType == ContentType.UserProfile);
                            var otherCounts = allReports.Count(r => r.ContentType != ContentType.News &&
                            r.ContentType != ContentType.Comment &&
                            r.ContentType != ContentType.UserProfile);

                            var total = allReports.Count();
                            var newsPercent = total > 0 ? (newsCounts * 100 / total) : 0;
                            var commentPercent = total > 0 ? (commentCounts * 100 / total) : 0;
                            var profilePercent = total > 0 ? (profileCounts * 100 / total) : 0;
                            var otherPercent = total > 0 ? (otherCounts * 100 / total) : 0;
                        }

                        <div class="progress mb-2" style="height: 25px;">
                            @if (newsPercent > 0)
                            {
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @newsPercent%;"
                                     aria-valuenow="@newsPercent" aria-valuemin="0" aria-valuemax="100">
                                    Новини (@newsCounts)
                                </div>
                            }
                            @if (commentPercent > 0)
                            {
                                <div class="progress-bar bg-info" role="progressbar" style="width: @commentPercent%;"
                                     aria-valuenow="@commentPercent" aria-valuemin="0" aria-valuemax="100">
                                    Коментарі (@commentCounts)
                                </div>
                            }
                            @if (profilePercent > 0)
                            {
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @profilePercent%;"
                                     aria-valuenow="@profilePercent" aria-valuemin="0" aria-valuemax="100">
                                    Профілі (@profileCounts)
                                </div>
                            }
                            @if (otherPercent > 0)
                            {
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: @otherPercent%;"
                                     aria-valuenow="@otherPercent" aria-valuemin="0" aria-valuemax="100">
                                    Інше (@otherCounts)
                                </div>
                            }
                        </div>
                    </div>

                    <h6>За статусом</h6>
                    <div>
                        @{
                            var pendingCount = allReports.Count(r => r.Status == ReportStatus.Pending);
                            var confirmedCount = allReports.Count(r => r.Status == ReportStatus.Confirmed);
                            var rejectedCount = allReports.Count(r => r.Status == ReportStatus.Rejected);
                            var resolvedCount = allReports.Count(r => r.Status == ReportStatus.Resolved);

                            var pendingPercent = total > 0 ? (pendingCount * 100 / total) : 0;
                            var confirmedPercent = total > 0 ? (confirmedCount * 100 / total) : 0;
                            var rejectedPercent = total > 0 ? (rejectedCount * 100 / total) : 0;
                            var resolvedPercent = total > 0 ? (resolvedCount * 100 / total) : 0;
                        }

                        <div class="progress mb-2" style="height: 25px;">
                            @if (pendingPercent > 0)
                            {
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @pendingPercent%;"
                                     aria-valuenow="@pendingPercent" aria-valuemin="0" aria-valuemax="100">
                                    Очікує (@pendingCount)
                                </div>
                            }
                            @if (confirmedPercent > 0)
                            {
                                <div class="progress-bar bg-danger" role="progressbar" style="width: @confirmedPercent%;"
                                     aria-valuenow="@confirmedPercent" aria-valuemin="0" aria-valuemax="100">
                                    Підтверджено (@confirmedCount)
                                </div>
                            }
                            @if (rejectedPercent > 0)
                            {
                                <div class="progress-bar bg-success" role="progressbar" style="width: @rejectedPercent%;"
                                     aria-valuenow="@rejectedPercent" aria-valuemin="0" aria-valuemax="100">
                                    Відхилено (@rejectedCount)
                                </div>
                            }
                            @if (resolvedPercent > 0)
                            {
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @resolvedPercent%;"
                                     aria-valuenow="@resolvedPercent" aria-valuemin="0" aria-valuemax="100">
                                    Вирішено (@resolvedCount)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Інформація</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-0">
                        <h6><i class="bi bi-lightbulb me-2"></i>Поради для модераторів:</h6>
                        <ul class="mb-0">
                            <li>Перевіряйте звіти в порядку їх надходження</li>
                            <li>Уважно перевіряйте контент на порушення правил</li>
                            <li>Залишайте чіткі коментарі щодо вашого рішення</li>
                            <li>У разі сумнівів, консультуйтеся з іншими модераторами</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>