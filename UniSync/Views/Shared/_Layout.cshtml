@using Microsoft.AspNetCore.Identity
@using UniSync.Areas.Identity.Data
@using UniSync.Constants
@inject UserManager<UniSyncUser> UserManager
@inject SignInManager<UniSyncUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniSync</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniSync.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-check brand-icon me-2"></i>
                    <span class="fw-bold">UniSync</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-lg-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="projectsDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-kanban me-1"></i> My Projects
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="projectsDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Projects" asp-action="Index">
                                            <i class="bi bi-list-ul me-2"></i> All Projects
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Projects" asp-action="Create">
                                            <i class="bi bi-plus-circle me-2"></i> Create New
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            var user = await UserManager.GetUserAsync(User);
                            var isAdmin = user != null && (await UserManager.IsInRoleAsync(user, Roles.Admin) ||
                            await UserManager.IsInRoleAsync(user, Roles.SuperAdmin));
                            var isModerator = user != null && await UserManager.IsInRoleAsync(user, Roles.Moderator);
                            var isCourseManager = user != null && await UserManager.IsInRoleAsync(user, Roles.CourseManager);
                            var isNewsEditor = user != null && await UserManager.IsInRoleAsync(user, Roles.NewsEditor);

                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i> Адміністрування
                                    </a>
                                    <ul class="dropdown-menu shadow-sm" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">
                                                <i class="bi bi-people me-2"></i> Управління користувачами
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-gear me-2"></i> Налаштування системи
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (isModerator)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="moderationDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-flag me-1"></i> Модерація
                                    </a>
                                    <ul class="dropdown-menu shadow-sm" aria-labelledby="moderationDropdown">
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-exclamation-triangle me-2"></i> Скарги
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-chat-dots me-2"></i> Коментарі
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (isCourseManager)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="coursesDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-mortarboard me-1"></i> Курси
                                    </a>
                                    <ul class="dropdown-menu shadow-sm" aria-labelledby="coursesDropdown">
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-list-check me-2"></i> Управління групами
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-graph-up me-2"></i> Статистика
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (isNewsEditor)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="newsDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-newspaper me-1"></i> Новини
                                    </a>
                                    <ul class="dropdown-menu shadow-sm" aria-labelledby="newsDropdown">
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-pencil-square me-2"></i> Створити новину
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="#">
                                                <i class="bi bi-list-ul me-2"></i> Управління новинами
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    
                    <!-- Right Menu Items -->
                    <div class="d-flex align-items-center">
                        <!-- Search -->
                        <div class="search-container me-3 d-none d-md-block">
                            <input type="text" class="search-input" placeholder="Search projects...">
                            <button class="search-button" type="button"><i class="bi bi-search"></i></button>
                        </div>

                        <!-- User Profile -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            var user = await UserManager.GetUserAsync(User);
                            <div class="dropdown">
                                <button class="btn btn-outline-primary dropdown-toggle d-flex align-items-center" 
                                        type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar-initials me-2">
                                        @{
                                            var firstInitial = !string.IsNullOrEmpty(user?.FirstName) ? user.FirstName[0] : '?';
                                            var secondInitial = !string.IsNullOrEmpty(user?.LastName) ? user.LastName[0] : ' ';
                                        }
                                        @firstInitial@secondInitial
                                    </span>
                                    <span class="d-none d-md-inline">@(user?.FirstName) @(user?.LastName)</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                            <i class="bi bi-person me-2"></i> Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Subjects" asp-action="Index">
                                            <i class="bi bi-book me-2"></i> My Subjects
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex">
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-box-arrow-in-right me-md-2"></i>
                                    <span class="d-none d-md-inline">Sign In</span>
                                </a>
                                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">
                                    <i class="bi bi-person-plus me-md-2"></i>
                                    <span class="d-none d-md-inline">Register</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>